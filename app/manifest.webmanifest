{ "name": "Vivora — video & music player", "short_name": "Vivora", "start_url": "./", "scope": "./", "display": "standalone", "background_color": "#0b0e1f", "theme_color": "#0b0e1f",
  "description": "Videos and music with folders, subtitles, equalizer and free music. Powered by Bubbles.",
  "icons": [{ "src": "../img/vivora-192.png", "sizes": "192x192", "type": "image/png" }, { "src": "../img/vivora-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }],
  "file_handlers": [{ "action": "./", "accept": { "video/*": [".mp4", ".mkv", ".webm", ".mov"], "audio/*": [".mp3", ".m4a", ".flac", ".wav", ".ogg", ".opus"] } }] }
